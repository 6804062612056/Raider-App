<RideInfoScreen>:
    FloatLayout:
        # Layer 1: รูปภาพพื้นหลัง bg2.jpg
        Image:
            source: 'images/bg2.jpg'
            allow_stretch: True
            keep_ratio: False
            size_hint: (1, 1)
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

        # Layer 2: เนื้อหาหลัก
        BoxLayout:
            orientation: "vertical"
            padding: ["24dp", "36dp", "24dp", "24dp"]
            spacing: "16dp"

            # หัวข้อหน้าจอ
            Label:
                text: "Ride Information"
                font_size: "28sp"
                bold: True
                color: 0.1, 0.1, 0.1, 1
                size_hint_y: None
                height: "40dp"
                halign: "center"
                valign: "middle"

            # ส่วนกรอบแสดงแผนที่ (ย่อมุมมนสวยงาม)
            Widget:
                size_hint: (1, None)
                height: "220dp"

                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16,]

                # แสดงแผนที่ทับบนกรอบมน
                StaticMapView:
                    id: map_view
                    pos: self.parent.pos
                    size: self.parent.size
                    lat: 13.738288
                    lon: 100.532340
                    zoom: 13

            # ============================================================
            #  INFO CARD (กล่องแสดงข้อมูลระยะทางและรายได้)
            # ============================================================
            BoxLayout:
                orientation: "vertical"
                size_hint: (1, None)
                height: "110dp"
                padding: ["20dp", "16dp", "20dp", "16dp"]
                spacing: "12dp"

                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.92  # สีขาวมุกโปร่งแสง
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [18,]
                    Color:
                        rgba: 0.85, 0.85, 0.85, 0.8  # เส้นขอบบางๆ
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 18)
                        width: 1.0

                # ระยะทาง Distance
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "26dp"

                    Label:
                        text: "Distance"
                        font_size: "15sp"
                        color: 0.4, 0.4, 0.4, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None

                    Label:
                        text: root.distance_text
                        font_size: "16sp"
                        bold: True
                        color: 0.1, 0.1, 0.1, 1
                        halign: "right"
                        valign: "middle"
                        text_size: self.width, None

                # เส้นแบ่งรายการ
                Widget:
                    size_hint_y: None
                    height: "1dp"
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                # รายได้ Earnings
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "28dp"

                    Label:
                        text: "Earnings"
                        font_size: "15sp"
                        color: 0.4, 0.4, 0.4, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None

                    Label:
                        text: root.earnings_text
                        font_size: "18sp"
                        bold: True
                        color: 0, 0.6, 0.2, 1  # สีเขียวสดใส
                        halign: "right"
                        valign: "middle"
                        text_size: self.width, None

            # ดันปุ่มปฏิบัติการลงล่าง
            Widget:
                size_hint_y: 1

            # ============================================================
            #  ACTION BUTTONS (ปุ่ม Reject และ Accept ทรงแคปซูล)
            # ============================================================
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "50dp"
                spacing: "14dp"

                # ปุ่ม Reject (สีแดงอ่อนทรงแคปซูล)
                Button:
                    text: "Reject"
                    font_size: "16sp"
                    bold: True
                    color: 0.85, 0.1, 0.1, 1
                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0
                    on_release: root.reject_ride()

                    canvas.before:
                        Color:
                            rgba: (1, 0.92, 0.92, 0.95) if self.state == 'normal' else (0.95, 0.8, 0.8, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [25,]
                        Color:
                            rgba: 0.85, 0.1, 0.1, 1
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 25)
                            width: 1.2

                # ปุ่ม Accept (สีเขียวสดใสทรงแคปซูล)
                Button:
                    text: "Accept"
                    font_size: "16sp"
                    bold: True
                    color: 1, 1, 1, 1
                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0
                    on_release: root.accept_ride()

                    canvas.before:
                        Color:
                            rgba: (0, 0.75, 0.3, 1) if self.state == 'normal' else (0, 0.6, 0.25, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [25,]