<RatingScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        # --- Title ---
        Label:
            text: "Rate Your Ride"
            font_size: "24sp"
            bold: True
            color: 0, 0, 0, 1
            size_hint: 1, None
            height: "40dp"
            halign: "center"
            valign: "middle"

        Widget:
            size_hint: 1, 0.2

        # --- Subtitle / Question (เปลี่ยนเป็น Rating) ---
        Label:
            text: "Rating"
            font_size: "18sp"
            color: 0.3, 0.3, 0.3, 1
            size_hint: 1, None
            height: "30dp"
            halign: "center"
            valign: "middle"

        # --- 1-5 Numbers Row ---
        BoxLayout:
            orientation: "horizontal"
            size_hint: 1, None
            height: "70dp"
            spacing: "10dp"
            padding: ["30dp", 0, "30dp", 0]

            Button:
                text: "1"
                font_size: "22sp"
                bold: True
                background_normal: ""
                background_color: (1, 0.8, 0, 1) if root.selected_rating >= 1 else (0.8, 0.8, 0.8, 1)
                color: (1, 1, 1, 1)
                on_release: root.set_rating(1)
            Button:
                text: "2"
                font_size: "22sp"
                bold: True
                background_normal: ""
                background_color: (1, 0.8, 0, 1) if root.selected_rating >= 2 else (0.8, 0.8, 0.8, 1)
                color: (1, 1, 1, 1)
                on_release: root.set_rating(2)
            Button:
                text: "3"
                font_size: "22sp"
                bold: True
                background_normal: ""
                background_color: (1, 0.8, 0, 1) if root.selected_rating >= 3 else (0.8, 0.8, 0.8, 1)
                color: (1, 1, 1, 1)
                on_release: root.set_rating(3)
            Button:
                text: "4"
                font_size: "22sp"
                bold: True
                background_normal: ""
                background_color: (1, 0.8, 0, 1) if root.selected_rating >= 4 else (0.8, 0.8, 0.8, 1)
                color: (1, 1, 1, 1)
                on_release: root.set_rating(4)
            Button:
                text: "5"
                font_size: "22sp"
                bold: True
                background_normal: ""
                background_color: (1, 0.8, 0, 1) if root.selected_rating >= 5 else (0.8, 0.8, 0.8, 1)
                color: (1, 1, 1, 1)
                on_release: root.set_rating(5)

        Widget:
            size_hint: 1, 0.4

        # --- Continue Button ---
        Button:
            text: "Continue"
            font_size: "18sp"
            bold: True
            size_hint: 1, None
            height: "50dp"
            background_normal: ""
            background_color: (0.93, 0.93, 0.93, 1)
            color: (0, 0, 0, 1)
            on_release: root.on_continue()

            canvas.after:
                Color:
                    rgba: 0, 0, 0, 1
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                    width: 1