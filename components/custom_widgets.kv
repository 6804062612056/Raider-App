#:kivy 2.0.0

#:import dp kivy.metrics.dp

#:import sp kivy.metrics.sp



# ============================================================

#  DESIGN TOKENS

# ============================================================

#:set YELLOW        (1, 0.8, 0, 1)

#:set YELLOW_DARK   (0.9, 0.7, 0, 1)

#:set INK_BLACK     (0.05, 0.05, 0.05, 1)   # สีตัวหนังสือขณะพิมพ์ (สีดำเข้ม)

#:set INK_MUTED     (0.6, 0.6, 0.6, 1)       # สี Hint Text (สีเทา)

#:set INK_BTN       (0.2, 0.2, 0.2, 1)

#:set LINE          (0.85, 0.85, 0.85, 1)

#:set DISABLED_BG   (0.88, 0.88, 0.88, 1)   # สีปุ่มตอนปิดใช้งาน (สีเทา)

#:set DISABLED_FG   (0.55, 0.55, 0.55, 1)   # สีตัวหนังสือปุ่มตอนเป็นสีเทา





# ============================================================
#  1. INPUT COMPONENT
# ============================================================
<Input1@TextInput>:
    size_hint: (1, None)
    height: '48dp'
    font_size: '16sp'
    multiline: False
    
    # 1. จัดกึ่งกลางแนวตั้งโดยคำนวณจากความสูงของ Input (48dp) ลบ ความสูงของฟอนต์
    padding: [dp(15), (self.height - self.line_height) / 2, dp(15), 0]
    
    foreground_color: INK_BLACK
    hint_text_color: INK_MUTED
    cursor_color: INK_BLACK

    background_color: 0, 0, 0, 0
    background_normal: ''
    background_active: ''

    canvas.before:
        Color:
            rgba: INK_MUTED if self.focus else INK_BLACK

        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 15)
            width: 1.08




# ============================================================

#  2. BUTTON COMPONENT

# ============================================================

<Button1@Button>:

    font_size: '20sp'

    bold: True

    size_hint: (1, None)

    height: '56dp'

    

    background_color: 0, 0, 0, 0

    background_normal: ''

    background_down: ''

    background_disabled: ''



    # เปลี่ยนสีตัวหนังสือตามสถานะ disabled

    color: DISABLED_FG if self.disabled else INK_BTN



    canvas.before:

        Color:

            # ถ้าถูกสั่ง disabled จะเป็นสีเทา (DISABLED_BG) 

            # ถ้าเปิดใช้งานปกติ จะสลับสีตามการกด (YELLOW_DARK ตอนกดลง / YELLOW ตอนปกติ)

            rgba: YELLOW_DARK if self.disabled else (YELLOW_DARK if self.state == 'down' else YELLOW)

        RoundedRectangle:

            pos: self.pos

            size: self.size

            radius: [20,] 

