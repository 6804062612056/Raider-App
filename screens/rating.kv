<RatingScreen>:
    FloatLayout:
        # Layer 1: ภาพพื้นหลัง bg2.jpg
        Image:
            source: 'images/bg2.jpg'
            allow_stretch: True
            keep_ratio: False
            size_hint: (1, 1)
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

        # Layer 2: เนื้อหาหลัก
        BoxLayout:
            orientation: "vertical"
            padding: ["24dp", "40dp", "24dp", "24dp"]
            spacing: "16dp"

            # --- Title ---
            Label:
                text: root.title_text
                font_size: "28sp"
                bold: True
                color: 0.1, 0.1, 0.1, 1
                size_hint_y: None
                height: "40dp"
                halign: "center"
                valign: "middle"

            Widget:
                size_hint_y: 1

            # --- Glassmorphic Card สำหรับส่วนลงคะแนน ---
            BoxLayout:
                orientation: "vertical"
                size_hint: (1, None)
                height: "180dp"
                padding: ["16dp", "24dp", "16dp", "24dp"]
                spacing: "20dp"

                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.92  # กล่องสีขาวมุกโปร่งแสง
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20,]
                    Color:
                        rgba: 0.85, 0.85, 0.85, 0.8  # เส้นขอบบางๆ
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
                        width: 1.0

                # --- Subtitle / Question ---
                Label:
                    text: "How was your experience?"
                    font_size: "16sp"
                    bold: True
                    color: 0.3, 0.3, 0.3, 1
                    size_hint_y: None
                    height: "24dp"
                    halign: "center"
                    valign: "middle"

                # --- Star Rating Row (ระบุ Path: images/star.png) ---
                BoxLayout:
                    orientation: "horizontal"
                    size_hint: (1, None)
                    height: "50dp"
                    spacing: "12dp"
                    pos_hint: {"center_x": 0.5}

                    # ดาวดวงที่ 1
                    Button:
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        on_release: root.set_rating(1)
                        Image:
                            source: 'images/star.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: "44dp", "44dp"
                            color: (1, 1, 1, 1) if root.selected_rating >= 1 else (0.5, 0.5, 0.5, 0.5)

                    # ดาวดวงที่ 2
                    Button:
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        on_release: root.set_rating(2)
                        Image:
                            source: 'images/star.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: "44dp", "44dp"
                            color: (1, 1, 1, 1) if root.selected_rating >= 2 else (0.5, 0.5, 0.5, 0.5)

                    # ดาวดวงที่ 3
                    Button:
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        on_release: root.set_rating(3)
                        Image:
                            source: 'images/star.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: "44dp", "44dp"
                            color: (1, 1, 1, 1) if root.selected_rating >= 3 else (0.5, 0.5, 0.5, 0.5)

                    # ดาวดวงที่ 4
                    Button:
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        on_release: root.set_rating(4)
                        Image:
                            source: 'images/star.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: "44dp", "44dp"
                            color: (1, 1, 1, 1) if root.selected_rating >= 4 else (0.5, 0.5, 0.5, 0.5)

                    # ดาวดวงที่ 5
                    Button:
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        on_release: root.set_rating(5)
                        Image:
                            source: 'images/star.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: "44dp", "44dp"
                            color: (1, 1, 1, 1) if root.selected_rating >= 5 else (0.5, 0.5, 0.5, 0.5)

            Widget:
                size_hint_y: 1

            # --- Continue Button (ทรงแคปซูลสีเหลืองสด) ---
            Button:
                text: "Continue"
                font_size: "16sp"
                bold: True
                color: 0.12, 0.16, 0.22, 1
                size_hint: (1, None)
                height: "50dp"
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                on_release: root.on_continue()

                canvas.before:
                    Color:
                        rgba: (1, 0.78, 0, 1) if self.state == 'normal' else (0.9, 0.7, 0, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [25,]